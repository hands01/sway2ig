configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

* {
    font: "JetBrains Mono 11";
    background-color: #1f1f1f;
    text-color: #ffffff;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 500;
    location: north;
    anchor: north;
    //y-offset: -20;
    y-offset: 8;

    border-radius: 0px;
    border: 2px;
    border-color: #1b4d3e;

    background-color: #1f1f1f;
}

mainbox {
    padding: 5px;
    background-color: #1f1f1f;
}

inputbar {
    background-color: #1f1f1f;
    border-radius: 0px;
    border: 0px;

    padding: 8px 12px;
    spacing: 8px;
}

prompt {
    text-color: #ffffff;
    background-color: #1f1f1f;
}

entry {
    text-color: #ffffff;
    placeholder: "search";
    placeholder-color: #ffffff;
    background-color: #1f1f1f;
}

listview {
    background-color: #1f1f1f;
    margin: 8px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

/* ===== Elements ===== */
element {
    padding: 8px 10px;
    spacing: 6px;
    border-radius: 0px;
}

element normal.normal {
    background-color: #1f1f1f;
    text-color: #ffffff;
}

element alternate.normal {
    background-color: #1f1f1f;
    text-color: #ffffff;
}

element normal.urgent {
    background-color: #2E2A27;
    text-color: #ffffff;
}

element normal.active {
    background-color: #1b4d3e;
    text-color: #ffffff;
}

element alternate.active {
    background-color: #1b4d3e;
    text-color: #ffffff;
}

element alternate.urgent {
    background-color: #2E2A27;
    text-color: #ffffff;
}

/* --- Add these lines to fix the selection color --- */

element selected.normal {
    background-color: #1b4d3e;  /* Your dark green */
    text-color: #ffffff;
}

element selected.active {
    background-color: #1b4d3e;  /* Your dark green */
    text-color: #ffffff;
}

element selected.urgent {
    background-color: #1b4d3e;  /* Your dark green */
    text-color: #ffffff;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    text-color: #ffffff;
    background-color: transparent;
}

message {
    margin: 8px 0 0;
    border-radius: 0px;
    border: 0px;

    background-color: #1f1f1f;
}

textbox {
    padding: 8px 16px;
    background-color: #1f1f1f;
}
