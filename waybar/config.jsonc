{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "height": 1,
  "margin-top": 7,
  "margin-left": 400,
  "margin-right": 400,
  "width": 810,

  "modules-left": [
    "custom/spacer",
    "custom/lock",
    "custom/separator",
    //"custom/power",
    "sway/workspaces"
  ],
  "modules-center": [
     "mpris"
//     "custom/media"
  ],

  "modules-right": [
    "tray",
    "network",
    "wireplumber",
    //"backlight",
    "battery",
    "clock",
    "custom/notification",
    //"custom/lock",
    //"custom/power"
    "custom/spacer"
  ],

  "custom/notification": {
    "format": "{icon}",
    "return-type": "json",
    "exec": "~/.config/rofi/waybar-dunst.sh",
    "on-click": "~/.config/rofi/rofi-notifications.sh",
    "format-icons": [" "],
    "interval": 2,
    "restart-interval": 2
},

  "battery": {
    "states": {
        "warning": 45,
        "critical": 30
    },
    "format": "{icon}",
    "format-charging": "  {capacity}%",
    "format-plugged": " {capacity}%",
    "format-warning": "{icon} {capacity}%",
    "format-critical": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
},


  "custom/spacer": {
    "format": " ",
    "tooltip": false
  },

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "sway/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
        "1": []
    }
},

  "mpris": {
    "format-playing": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "🎵 Nothing is playing",
    "dynamic-order": ["title", "artist"],
    "status-icons": {
        "playing": "⏸ ",
        "paused": "▶ "
    },
    "max-length": 35
    //"ellipsis": "...",
    //"dynamic-lens": 40
},

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-disconnected": "⚠ Dis",
    "on-click": "bash ~/.config/rofi/wifi.sh",
    "tooltip": true,
    "tooltip-format-wifi": "SSID: {essid} | Strength: {signalStrength}%"
  },
  
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "Muted",
    "on-click": "pavucontrol",
    "max-volume": 100,
    "format-icons": {
        "headphone": "",
        "headset": "  ",
        "default": ["", "", ""]
     }
  },


  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "custom/lock": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/powermenu.sh",
    "tooltip": true,
    "tooltip-format": "Power Menu"
   }
}
